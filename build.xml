<?xml version="1.0" encoding="UTF-8"?>
<project name="SecureGroupCommunication" default="build" basedir=".">
    <description>
        Secure Group Communication System - Build File
        Java-based secure messaging with encryption and digital signatures
    </description>

    <!-- Set global properties -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="lib"/>
    <property name="config.dir" value="config"/>
    <property name="images.dir" value="resources/images"/>
    
    <!-- Java version properties -->
    <property name="java.version" value="1.6"/>
    <property name="source.version" value="1.6"/>
    <property name="target.version" value="1.6"/>

    <!-- Classpath for compilation -->
    <path id="compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <!-- Initialize build directories -->
    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.dir}/classes"/>
        <mkdir dir="${dist.dir}"/>
        <echo message="Build directories initialized"/>
    </target>

    <!-- Clean build artifacts -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <echo message="Build artifacts cleaned"/>
    </target>

    <!-- Compile Java source files -->
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" 
               destdir="${build.dir}/classes"
               classpathref="compile.classpath"
               source="${source.version}"
               target="${target.version}"
               debug="true"
               debuglevel="lines,vars,source">
            <compilerarg value="-Xlint:deprecation"/>
            <compilerarg value="-Xlint:unchecked"/>
        </javac>
        <echo message="Compilation completed"/>
    </target>

    <!-- Create JAR distribution -->
    <target name="jar" depends="compile">
        <copy todir="${build.dir}/classes">
            <fileset dir="${config.dir}">
                <include name="**/*"/>
            </fileset>
        </copy>
        <copy todir="${build.dir}/classes">
            <fileset dir="${images.dir}">
                <include name="**/*"/>
            </fileset>
        </copy>
        <jar jarfile="${dist.dir}/SecureGroupCommunication.jar" 
             basedir="${build.dir}/classes">
            <manifest>
                <attribute name="Main-Class" value="com.securecommunication.ui.Login"/>
                <attribute name="Implementation-Title" value="Secure Group Communication"/>
                <attribute name="Implementation-Version" value="1.0"/>
                <attribute name="Implementation-Vendor" value="Security Team"/>
            </manifest>
        </jar>
        <echo message="JAR created: ${dist.dir}/SecureGroupCommunication.jar"/>
    </target>

    <!-- Build all -->
    <target name="build" depends="clean,compile,jar">
        <echo message="Build completed successfully"/>
    </target>

    <!-- Run application -->
    <target name="run" depends="build">
        <java classname="com.securecommunication.ui.Login" fork="true">
            <classpath>
                <pathelement location="${dist.dir}/SecureGroupCommunication.jar"/>
                <path refid="compile.classpath"/>
            </classpath>
        </java>
    </target>

</project>
